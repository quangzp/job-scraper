# Coolify production environment example.
# Paste these variables into Coolify -> Environment Variables -> Developer View.
# Do not commit real secrets in .env files.

# Runtime
DJANGO_ENV=PROD
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=your-vps-public-ip
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-vps-public-ip:8001
DJANGO_DB_LOG_LEVEL=INFO
TZ=Asia/Saigon

# Static files and HTTP test cookies.
# For HTTPS/domain production, change both cookie values to True.
DJANGO_STATIC_ROOT=staticfiles
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Web server
WEB_PUBLIC_PORT=8001
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Scraper loop timing
HARVEST_LOOP_SLEEP_MIN_SECONDS=2700
HARVEST_LOOP_SLEEP_MAX_SECONDS=5400

# LinkedIn harvester credentials and reusable browser session storage.
LINKEDIN_EMAIL=replace-with-linkedin-email
LINKEDIN_PASSWORD=replace-with-linkedin-password
LINKEDIN_SESSION_DIR=storage/sessions/linkedin

# Database provider: use "supabase" or "postgres".
DB_PROVIDER=supabase

# Supabase PostgreSQL connection.
# Use the direct database host and password from Supabase project settings.
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-supabase-db-password
SUPABASE_DB_HOST=replace-with-supabase-db-host
SUPABASE_DB_PORT=5432
SUPABASE_SSLMODE=require
SUPABASE_CONN_MAX_AGE=0
SUPABASE_CONNECT_TIMEOUT=10

# External PostgreSQL alternative.
# If using this block, set DB_PROVIDER=postgres and fill these values.
# POSTGRES_DB=job_platform
# POSTGRES_USER=replace-with-postgres-user
# POSTGRES_PASSWORD=replace-with-postgres-password
# POSTGRES_HOST=replace-with-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60
# POSTGRES_CONNECT_TIMEOUT=10

# Scraper browser backend: playwright or cloakbrowser
SCRAPER_BROWSER=cloakbrowser
CLOAKBROWSER_MAX_OPEN_PAGES=1
